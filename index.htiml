<!DOCTYPE html>
<html lang="gu">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chat Go</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #eaf1f8;
    }
    header {
      background: #087cf0;
      color: white;
      padding: 18px;
      font-size: 25px;
      font-weight: bold;
    }
    .subtitle { font-size: 13px; margin-top: 5px; }
    .container {
      max-width: 600px;
      margin: 20px auto;
      padding: 12px;
    }
    .panel {
      background: white;
      border-radius: 14px;
      padding: 16px;
      box-shadow: 0 2px 10px #0001;
    }
    #messages {
      height: 55vh;
      min-height: 250px;
      overflow-y: auto;
      padding: 10px 0;
    }
    .msg {
      background: #dceeff;
      padding: 10px 13px;
      border-radius: 12px;
      margin: 9px 0;
      overflow-wrap: anywhere;
    }
    .time { font-size: 10px; color: #555; margin-top: 5px; }
    .inputrow { display: flex; gap: 8px; }
    input {
      min-width: 0;
      flex: 1;
      padding: 13px;
      border: 1px solid #ccd5df;
      border-radius: 10px;
      font-size: 16px;
    }
    button {
      border: 0;
      background: #087cf0;
      color: white;
      padding: 12px 16px;
      border-radius: 10px;
      cursor: pointer;
    }
    .note { color: #555; font-size: 12px; margin-top: 12px; }
  </style>
</head>
<body>
  <header>
    Chat Go
    <div class="subtitle">તમારી ચેટ, તમારી દુનિયા 💬</div>
  </header>

  <main class="container">
    <section class="panel">
      <h3>મેસેજિસ 💬</h3>
      <div id="messages"></div>
      <form id="chatForm" class="inputrow">
        <input id="messageInput" placeholder="મેસેજ લખો..." autocomplete="off">
        <button type="submit">મોકલો</button>
      </form>
      <p class="note">આ શરૂઆતનું ડેમો છે. મેસેજ આ બ્રાઉઝરમાં જ રહેશે; હજી બીજા યુઝરને મોકલાતા નથી.</p>
    </section>
  </main>

  <script>
    const messages = document.getElementById("messages");
    const form = document.getElementById("chatForm");
    const input = document.getElementById("messageInput");

    let saved = [];
    try {
      saved = JSON.parse(localStorage.getItem("chatgo_messages") || "[]");
    } catch (e) {}

    function showMessages() {
      messages.replaceChildren();
      saved.forEach(item => {
        const box = document.createElement("div");
        box.className = "msg";

        const text = document.createElement("div");
        text.textContent = item.text;

        const time = document.createElement("div");
        time.className = "time";
        time.textContent = item.time;

        box.append(text, time);
        messages.appendChild(box);
      });
      messages.scrollTop = messages.scrollHeight;
    }

    form.addEventListener("submit", function(e) {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;

      saved.push({
        text: text,
        time: new Date().toLocaleString()
      });

      try {
        localStorage.setItem("chatgo_messages", JSON.stringify(saved));
      } catch (e) {}

      input.value = "";
      showMessages();
    });

    showMessages();
  </script>
</body>
</html>
